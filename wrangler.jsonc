{
  // Code-level config is merged from the upstream Worker during deployment.
  "name": "yamp",
  "workers_dev": true,

  // Existing KV namespaces created during the initial deployment.
  "kv_namespaces": [
    {
      "binding": "KROGER_KV",
      "id": "abfa8a93a67d4fcb85578316f096dc52"
    },
    {
      "binding": "TENANT_KV",
      "id": "292cb48cbdd94251a3f0767505e05d14"
    },
    {
      "binding": "OAUTH_KV",
      "id": "4726778930764bdd860bb20827e13149"
    }
  ],

  // Wrangler has already created this database and can resolve it by name.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yamp",
      "migrations_dir": "migrations/d1"
    }
  ]
}
